# 复制为 .env 后按实际环境修改；.env 不入库（见 .gitignore）
# 优先级：显式 export 的环境变量 > .env > config.py 内置默认值
# 标记 CHANGE_ME 的四项必须改成真实值，不要沿用公开仓库里的历史密钥

# ---- app.py 入库 MySQL ----
DB_HOST=134.84.22.233
DB_PORT=6306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=ntt_xiaoxin_agent
# 若线上 app 库实际是 8086 端口，改成 DB_PORT=8086

# ---- generate_qa.py 读写 MySQL（与 app 库地址不同，单独一份）----
QA_DB_HOST=172.21.224.71
QA_DB_PORT=6306
QA_DB_USER=root
QA_DB_PASSWORD=CHANGE_ME
QA_DB_NAME=ntt_xiaoxin_agent

# ---- GBase opera 库（工单原始明细）----
GBASE_HOST=134.85.16.139
GBASE_PORT=5258
GBASE_USER=busiopera
GBASE_PASSWORD=CHANGE_ME
GBASE_DB=opera

# ---- 后端取数接口 ----
BACKEND_API_URL=http://134.84.22.233:6308/xxa/queryListByTime

# ---- 直连大模型（OpenAI 兼容 /v1/chat/completions）----
LLM_URL=http://134.84.255.13:23471/v1/chat/completions
LLM_API_KEY=CHANGE_ME
LLM_MODEL=CXY-Qwen3-32B
QA_LLM_MODEL=cxy-deepseek-v3-0324
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
# 一次工单 = 8 次模型调用，按服务端承载能力调整
LLM_QPS=2
LLM_STREAM=false

# ---- 运行节奏 ----
MAX_WORKERS=1
FIELD_WORKERS=6
POST_CALL_SLEEP=5
BATCH_DAY_SLEEP=2
SCHEDULE_TIME=01:00
