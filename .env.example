# 本地运行配置模板（脱敏）。
# 用法：cp .env.example .env 后按实际环境填写；真实凭据不要提交到公开仓库。
# 优先级：显式 export 的环境变量 > .env > xiaoxin/config.py 内置默认值。
# 注意：注释请独立成行，不要在值后面跟行内注释。

# ---- app 入库 MySQL（MYSQL_CONFIG）----
DB_HOST=<数据库地址>
DB_PORT=6306
DB_USER=<用户名>
DB_PASSWORD=<密码>
DB_NAME=<库名>

# ---- QA 读写 MySQL（QA_MYSQL_CONFIG）----
QA_DB_HOST=<数据库地址>
QA_DB_PORT=6306
QA_DB_USER=<用户名>
QA_DB_PASSWORD=<密码>
QA_DB_NAME=<库名>

# ---- GBase opera 库（工单原始明细，只读）----
GBASE_HOST=<数据库地址>
GBASE_PORT=5258
GBASE_USER=<用户名>
GBASE_PASSWORD=<密码>
GBASE_DB=opera

# ---- 后端取数接口 ----
BACKEND_API_URL=<http://host:port/xxa/queryListByTime>

# ---- 直连大模型（OpenAI 兼容 /v1/chat/completions）----
LLM_URL=<http://host:port/v1/chat/completions>
LLM_API_KEY=<模型服务 API Key>
LLM_MODEL=<提取模型名>
QA_LLM_MODEL=<QA 聚类模型名>
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_QPS=2
LLM_STREAM=false

# ---- 运行节奏 ----
MAX_WORKERS=1
FIELD_WORKERS=6
POST_CALL_SLEEP=5
BATCH_DAY_SLEEP=2
SCHEDULE_TIME=01:00
