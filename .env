# 本地运行配置（个人局域网，凭据照实填写）
# 由原仓库各源码文件逐项导出；config.py 启动时自动加载本文件。
# 优先级：显式 export 的环境变量 > 本文件 > config.py 内置默认值
# 注意：注释请独立成行，不要在值后面跟行内注释。

# ---- app 入库 MySQL（MYSQL_CONFIG，见 xiaoxin_work_order/config.py）----
# 来源：重构前入库脚本的 DB_CONFIG；原两份脚本端口 8086 / 6306 不一致，
# 合并为单入口后按多数文件取 6306，若每日任务实际连 8086 改成 8086。
DB_HOST=134.84.22.233
DB_PORT=6306
DB_USER=root
DB_PASSWORD=Nttslgkpt*2024
DB_NAME=ntt_xiaoxin_agent

# ---- QA 读写 MySQL（QA_MYSQL_CONFIG，见 xiaoxin_work_order/config.py）----
# 来源：重构前 QA 脚本的 DB_CONFIG（地址与 app 库不同）
QA_DB_HOST=172.21.224.71
QA_DB_PORT=6306
QA_DB_USER=root
QA_DB_PASSWORD=Nttslgkpt*2024
QA_DB_NAME=ntt_xiaoxin_agent
# 历史备注：已删除的 sql_query.py 里密码写作 Nntslgkpt*2024（与上面差一个字母），
# 它连的是 134.84.22.233:6306；重构后按 id 反查统一走上面的 QA_DB_*，故以此为准。

# ---- GBase opera 库（工单原始明细）----
# 来源：gbase_excel_query.py 的 GBASE_CONFIG
GBASE_HOST=134.85.16.139
GBASE_PORT=5258
GBASE_USER=busiopera
GBASE_PASSWORD=Busiopera#2025
GBASE_DB=opera

# ---- 后端取数接口 ----
# 来源：重构前入库脚本的 API_URL（现由 xiaoxin_work_order/api/backend.py 使用）
BACKEND_API_URL=http://134.84.22.233:6308/xxa/queryListByTime

# ---- 直连大模型（OpenAI 兼容 /v1/chat/completions）----
# 来源：model.py 生效的 URL / API_KEY / MODEL；Dify 的 app-xxx key 已随去 Dify 一起作废，不写入。
LLM_URL=http://134.84.255.13:23471/v1/chat/completions
LLM_API_KEY=sk-PxwP10Ndr_vJZ-s2sbTE2A
# 提取工作流用 yml 里 8 个 LLM 节点的模型名
LLM_MODEL=CXY-Qwen3-32B
# QA 聚类用 model.py 里的模型名
QA_LLM_MODEL=cxy-deepseek-v3-0324
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
# 一次工单 = 8 次模型调用，按服务端承载能力调整
LLM_QPS=2
LLM_STREAM=false

# ---- 运行节奏 ----
MAX_WORKERS=1
FIELD_WORKERS=6
POST_CALL_SLEEP=5
BATCH_DAY_SLEEP=2
SCHEDULE_TIME=01:00

# ---- 每日批次：就绪探测 / 当日重试 ----
# 上游数据为空或仍在增长时不入库；连续两次指纹一致才跑模型。
# 重试严格限制在运行日当天，跨天即放弃（需手动 --mode batch 补跑）。
RETRY_INTERVAL_HOURS=1
STABILITY_RECHECK_MINUTES=10
RETRY_WINDOW_END=23:00
MAX_RETRY_ATTEMPTS=24
SCHEDULER_POLL_SECONDS=60
